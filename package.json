{
  "name": "mindmap-desktop-app",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "homepage": "./",
  "scripts": {
    "build-main": "npx tsc src/main/main.ts --outDir dist/main --target es2020 --module commonjs --esModuleInterop --allowSyntheticDefaultImports",
    "build-renderer": "webpack --mode production",
    "build": "npm run build-main && npm run build-renderer",
    "start-renderer": "webpack serve --mode development",
    "start-main": "electron dist/main/main.js",
    "dev": "concurrently \"npm run start-renderer\" \"wait-on http://localhost:3000 && npm run build-main && NODE_ENV=development npm run start-main\"",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "mindmap",
    "desktop",
    "electron",
    "react"
  ],
  "author": "Devin AI",
  "license": "MIT",
  "description": "A desktop mind mapping application built with Electron, React, and TypeScript",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.0",
    "css-loader": "^7.1.2",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.4",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "build": {
    "appId": "com.devin.mindmap-desktop-app",
    "productName": "Mind Map Desktop App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/bundle.js",
      "dist/index.html",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
